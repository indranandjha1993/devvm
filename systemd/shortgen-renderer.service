[Unit]
Description=ShortGen Local Render Service (FFmpeg, replaces json2video)
After=network-online.target
Wants=network-online.target
AssertFileIsExecutable=/usr/bin/python3
AssertPathExists=/opt/shortgen-renderer/renderer.py

[Service]
Type=simple
User=shortgen
Group=shortgen
Environment=RENDERER_PORT=8088
Environment=RENDERER_FONT=Oswald
Environment=RENDER_CONCURRENCY=1
# Optional VM-local asset fetch (skip cloudflare round-trip). Uncomment to enable:
# Environment=S3_REWRITE_FROM=https://s3-local.orrava.in
# Environment=S3_REWRITE_TO=http://127.0.0.1:9000
ExecStart=/usr/bin/python3 /opt/shortgen-renderer/renderer.py
Restart=always
RestartSec=5
TimeoutStopSec=20

# Resource caps — polite neighbour to Postgres/MinIO/n8n on the dev VM
CPUQuota=400%
MemoryMax=1500M
TasksMax=256

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
